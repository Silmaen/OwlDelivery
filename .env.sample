# Environment variables for the Django application
DEBUG_MODE=False
TZ=Europe/Paris
PUID=1000
PGID=1000
PORT=8080
PATH_DATA=./docker_data/data
DOMAIN_NAME=example.com
# Optional: other host names than DOMAIN_NAME, comma separated (a LAN address, ...)
ALLOWED_HOSTS=
# Optional: Django secret key; when empty, one is generated in PATH_DATA/secret_key at first start
SECRET_KEY=
# First admin user; leave ADMIN_PASSWD empty to get a generated one in PATH_DATA/initial_admin_password
ADMIN_NAME=admin
ADMIN_PASSWD=
# SMTP configuration
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Optional: Enable staff user creation (default: False)
ENABLE_STAFF=False
# Optional: Number of Gunicorn worker processes (default: 4)
GUNICORN_WORKERS=4
